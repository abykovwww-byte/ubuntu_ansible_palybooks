[Unit]
Description=Private HTTPS entry for Obsidian through Tailscale Serve
After=network-online.target tailscaled.service docker.service
Wants=network-online.target
Requires=tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=40
ExecStart=/usr/bin/tailscale serve --bg --https={{ obsidian_https_port }} http://127.0.0.1:{{ obsidian_http_port }}
ExecStop=/usr/bin/tailscale serve --https={{ obsidian_https_port }} off

[Install]
WantedBy=multi-user.target
