services:
  influxdb:
    image: {{ ngfw_metrics_influx_image | to_json }}
    restart: unless-stopped
    ports:
      - "{{ ngfw_metrics_influx_bind_address }}:{{ ngfw_metrics_influx_port }}:8086"
    environment:
      INFLUXDB_DB: {{ ngfw_metrics_db | to_json }}
      INFLUXDB_HTTP_AUTH_ENABLED: "false"
      INFLUXDB_REPORTING_DISABLED: "true"
    volumes:
      - "{{ ngfw_metrics_data }}/influxdb:/var/lib/influxdb"
    cpus: {{ ngfw_metrics_influx_cpus | to_json }}
    mem_limit: {{ ngfw_metrics_influx_memory | to_json }}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
