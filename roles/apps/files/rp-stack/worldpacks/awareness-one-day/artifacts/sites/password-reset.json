{
  "id": "password-reset",
  "revision": 1,
  "renderer": "credential-form",
  "theme": "office-neutral",
  "fixed": {
    "display_url": "https://account-recovery.example.test/reset",
    "field_ids": ["account", "new-password", "confirm-password"],
    "field_types": {"account": "email", "new-password": "password", "confirm-password": "password"},
    "credential_field_ids": ["account", "new-password", "confirm-password"],
    "actions": ["submit", "close", "report"]
  },
  "llm_slots": {
    "page_title": {"required": true, "max_length": 120},
    "page_subtitle": {"required": true, "max_length": 240},
    "account_label": {"required": true, "max_length": 80},
    "new_password_label": {"required": true, "max_length": 80},
    "confirm_password_label": {"required": true, "max_length": 80},
    "submit_label": {"required": true, "max_length": 80},
    "post_submit_message": {"required": true, "max_length": 240}
  },
  "fallback_content": {
    "page_title": "Восстановление доступа",
    "page_subtitle": "Укажите учётную запись и новый пароль",
    "account_label": "Учётная запись",
    "new_password_label": "Новый пароль",
    "confirm_password_label": "Повторите пароль",
    "submit_label": "Сохранить",
    "post_submit_message": "Изменения приняты"
  }
}
