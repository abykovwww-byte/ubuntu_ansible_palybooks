FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends nftables iproute2 curl util-linux \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --group network --no-dev
COPY security_lab ./security_lab
COPY proxy_addon.py ./
COPY lab ./lab
ENV PATH="/app/.venv/bin:${PATH}" PYTHONPATH=/app
RUN useradd --uid 1000 --create-home worker
# This image belongs only to the ephemeral CI fixture. It is not a production
# worker, and is never deployed to abykovserv by inventory/Ansible.
