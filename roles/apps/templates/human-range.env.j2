COMPOSE_PROJECT_NAME=human-range
POSTGRES_DB=human_range
POSTGRES_USER=human_range
POSTGRES_PASSWORD={{ hr_postgres_password }}
DATABASE_URL=postgresql+psycopg://human_range:{{ hr_postgres_password }}@db:5432/human_range
SESSION_SECRET={{ hr_session_secret }}
ADMIN_TOKEN={{ hr_admin_token }}
WEB_BIND_HOST={{ human_range_bind_host }}
WEB_PORT={{ human_range_port }}
ALLOWED_ORIGINS=http://{{ human_range_bind_host }}:{{ human_range_port }}
SECURE_COOKIE=false
ENABLE_ASSESSMENT=false
LLM_MODE={{ human_range_llm_mode }}
LLM_NETWORK_ENABLED={{ human_range_llm_network_enabled | bool | lower }}
LLM_CONFIG_PATH={{ human_range_llm_config_path }}
OPENROUTER_API_KEY={{ human_range_openrouter_api_key }}
MODEL_WRITER={{ human_range_model_writer }}
MODEL_RESPONDER={{ human_range_model_responder }}
MODEL_RESPONDER_SHORT={{ human_range_model_responder_short }}
MODEL_DECISION={{ human_range_model_decision }}
DECISION_CONFIDENCE_THRESHOLD={{ human_range_decision_threshold }}
