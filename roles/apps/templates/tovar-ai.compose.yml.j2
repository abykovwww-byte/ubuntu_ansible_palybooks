---
services:
  tovar-ai:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: tovar-ai
    restart: unless-stopped
    env_file:
      - .env
    ports:
      - "{{ tovar_ai_bind_host }}:{{ tovar_ai_host_port }}:{{ tovar_ai_container_port }}"
    volumes:
      - "{{ tovar_ai_log_dir }}:/app/logs"

