PROVIDER_MODEL_CATALOG_TTL_SECONDS={{ rp_stack_provider_model_catalog_ttl_seconds | default(86400) }}
LOCAL_LLM_ENABLED={{ rp_stack_local_llm_enabled | default(false) | ternary('true', 'false') }}
LOCAL_LLM_BASE_URL={{ rp_stack_local_llm_base_url | default('http://rp-local-llm:8080/v1') }}
