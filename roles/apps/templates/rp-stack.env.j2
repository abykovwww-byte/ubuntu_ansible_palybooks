APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT={{ rp_stack_gateway_port }}
SCENARIO_TYPE=rp
DATABASE_URL={{ rp_stack_gateway_database_url }}
RP_DATABASE_URL={{ rp_stack_gateway_rp_database_url | default('sqlite:////data/rp_engine.db') }}
WORLD_PACKS_PATH=/worldpacks

RP_NARRATOR_ENABLED={{ rp_stack_rp_narrator_enabled | default(true) | ternary('true', 'false') }}
RP_ATOMIC_SERVICE_ENABLED={{ rp_stack_rp_atomic_service_enabled | default(true) | ternary('true', 'false') }}
RP_ADMINISTRATOR_ENABLED={{ rp_stack_rp_administrator_enabled | default(true) | ternary('true', 'false') }}
RP_DERIVED_WAIT_SECONDS={{ rp_stack_rp_derived_wait_seconds | default(15) }}
RP_RUNNER_POLL_INTERVAL_SECONDS={{ rp_stack_rp_runner_poll_interval_seconds | default(0.05) }}

OPENROUTER_API_BASE={{ rp_stack_openrouter_api_base | default('https://openrouter.ai/api/v1') }}
OPENROUTER_API_KEY={{ rp_stack_openrouter_api_key | default('') }}
SERVICE_OPENROUTER_API_KEY={{ rp_stack_service_openrouter_api_key | default('') }}
GEMINI_API_BASE={{ rp_stack_gemini_api_base | default('https://generativelanguage.googleapis.com/v1beta/openai') }}
GEMINI_API_KEY={{ rp_stack_gemini_api_key | default('') }}
LOCAL_LLM_ENABLED={{ rp_stack_local_llm_enabled | default(true) | ternary('true', 'false') }}
LOCAL_LLM_BASE_URL={{ rp_stack_local_llm_base_url | default('http://rp-local-llm:8080/v1') }}
LOCAL_LLM_MODEL_ALIAS={{ rp_stack_local_llm_model_alias | default('gemma-4-26b-a4b-it-rp-q4') }}
LOCAL_LLM_CONTEXT_TOKENS={{ rp_stack_local_llm_context_tokens | default(32768) }}
MODEL_ATTEMPT_TIMEOUT_SECONDS={{ rp_stack_gateway_model_attempt_timeout_seconds | default(150) }}

LOG_LEVEL={{ rp_stack_gateway_log_level | default('INFO') }}
GATEWAY_AUTH_ENABLED={{ rp_stack_gateway_auth_enabled | default(true) | ternary('true', 'false') }}
GATEWAY_BOOTSTRAP_ADMIN_USERNAME={{ rp_stack_gateway_bootstrap_admin_username | default('admin') }}
GATEWAY_BOOTSTRAP_ADMIN_PASSWORD={{ rp_stack_gateway_bootstrap_admin_password | default(lookup('ansible.builtin.password', '/etc/ansible/rp-stack-gateway-admin-password length=24 chars=ascii_letters,digits')) }}
GATEWAY_SESSION_COOKIE_NAME={{ rp_stack_gateway_session_cookie_name | default('rp_gateway_session') }}
GATEWAY_SESSION_TTL_SECONDS={{ rp_stack_gateway_session_ttl_seconds | default(1209600) }}
GATEWAY_COOKIE_SECURE={{ rp_stack_gateway_cookie_secure | default(false) | ternary('true', 'false') }}
