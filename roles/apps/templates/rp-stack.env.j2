SERVICE_JOB_RETRY_BASE_SECONDS={{ rp_stack_service_job_retry_base_seconds | default(5) }}
SERVICE_JOB_RETRY_MAX_SECONDS={{ rp_stack_service_job_retry_max_seconds | default(300) }}
OPENROUTER_PROMPT_CACHE_ENABLED={{ rp_stack_openrouter_prompt_cache_enabled | default(true) | ternary('true', 'false') }}
OPENROUTER_PROMPT_CACHE_TTL={{ rp_stack_openrouter_prompt_cache_ttl | default('5m') }}
JOURNAL_AUTO_MIN_UNSUMMARIZED_TURNS={{ rp_stack_journal_auto_min_unsummarized_turns | default(24) }}
JOURNAL_MAX_BATCH_TURNS={{ rp_stack_journal_max_batch_turns | default(48) }}
GATEWAY_AUTH_ENABLED={{ rp_stack_gateway_auth_enabled | default(true) | ternary('true', 'false') }}
GATEWAY_BOOTSTRAP_ADMIN_USERNAME={{ rp_stack_gateway_bootstrap_admin_username | default('admin') }}
GATEWAY_BOOTSTRAP_ADMIN_PASSWORD={{ rp_stack_gateway_bootstrap_admin_password | default(lookup('ansible.builtin.password', '/etc/ansible/rp-stack-gateway-admin-password length=24 chars=ascii_letters,digits')) }}
GATEWAY_SESSION_TTL_SECONDS={{ rp_stack_gateway_session_ttl_seconds | default(1209600) }}
GATEWAY_COOKIE_SECURE={{ rp_stack_gateway_cookie_secure | default(false) | ternary('true', 'false') }}
SHOWROOM_VISITOR_COOKIE_NAME={{ rp_stack_showroom_visitor_cookie_name | default('rp_showroom_visitor') }}
SHOWROOM_VISITOR_TTL_SECONDS={{ rp_stack_showroom_visitor_ttl_seconds | default(2592000) }}
SHOWROOM_COVER_DIR=/data/showroom-covers
SHOWROOM_COVER_MAX_BYTES={{ rp_stack_showroom_cover_max_bytes | default(5242880) }}
