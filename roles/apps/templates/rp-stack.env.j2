POST_TURN_HELPERS_INLINE={{ rp_stack_post_turn_helpers_inline | default(false) | ternary('true', 'false') }}
PARTY_CONTEXT_MAX_TOKENS={{ rp_stack_party_context_max_tokens | default(131072) }}
PARTY_CONTEXT_COMPLETION_RESERVE_TOKENS={{ rp_stack_party_context_completion_reserve_tokens | default(16384) }}
PARTY_CONTEXT_SYSTEM_RESERVE_TOKENS={{ rp_stack_party_context_system_reserve_tokens | default(32768) }}
