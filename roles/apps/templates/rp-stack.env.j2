SILLYTAVERN_LISTEN=true
SILLYTAVERN_PORT=8000
SILLYTAVERN_PROTOCOL_IPV4=true
SILLYTAVERN_PROTOCOL_IPV6=false
SILLYTAVERN_WHITELISTMODE=true
SILLYTAVERN_WHITELIST={{ rp_stack_sillytavern_whitelist | to_json }}
SILLYTAVERN_WHITELISTDOCKERHOSTS=true
SILLYTAVERN_BASICAUTHMODE={{ rp_stack_sillytavern_basic_auth_enabled | default(true) | bool | lower }}
SILLYTAVERN_BASICAUTHUSER_USERNAME={{ rp_stack_sillytavern_basic_auth_user }}
SILLYTAVERN_BASICAUTHUSER_PASSWORD={{ rp_stack_sillytavern_basic_auth_password }}
SILLYTAVERN_HEARTBEATINTERVAL=30
SILLYTAVERN_LOGGING_MINLOGLEVEL=1

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT={{ rp_stack_gateway_port }}
CAMPAIGN_ID=default
DATABASE_URL={{ rp_stack_gateway_database_url }}
WORLD_STATE_PATH=/state/current.json
PARTY_STATE_ROOT=/state/parties
STATE_SCHEMA_PATH=/state/schema.json
WORLD_PACKS_PATH=/worldpacks
NVIDIA_API_BASE={{ rp_stack_nvidia_api_base }}
NVIDIA_API_KEY={{ rp_stack_nvidia_api_key | default('') }}
NVIDIA_MODEL_CATALOG_LIVE={{ rp_stack_nvidia_model_catalog_live | default(true) | ternary('true', 'false') }}
NVIDIA_MODEL_CATALOG_URL={{ rp_stack_nvidia_model_catalog_url | default('https://build.nvidia.com/models?q=llm') }}
NVIDIA_MODEL_CATALOG_TTL_SECONDS={{ rp_stack_nvidia_model_catalog_ttl_seconds | default(86400) }}
NARRATIVE_MODEL={{ rp_stack_nvidia_model }}
INTENT_MODEL={{ rp_stack_nvidia_model }}
VALIDATOR_MODEL={{ rp_stack_nvidia_model }}
LOG_LEVEL={{ rp_stack_gateway_log_level }}
LOG_PROMPTS={{ rp_stack_gateway_log_prompts }}
MAX_REPAIR_ATTEMPTS={{ rp_stack_gateway_max_repair_attempts }}
