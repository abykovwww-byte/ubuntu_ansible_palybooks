---
services:
  opensearch:
    image: "opensearchproject/opensearch:{{ opensearch_ad_version }}"
    container_name: ad-opensearch
    restart: unless-stopped
    env_file:
      - .env
    environment:
      - cluster.name={{ opensearch_ad_cluster_name }}
      - node.name=ad-opensearch-node1
      - discovery.type=single-node
      - bootstrap.memory_lock=true
      - OPENSEARCH_INITIAL_ADMIN_PASSWORD=${OPENSEARCH_INITIAL_ADMIN_PASSWORD}
      - OPENSEARCH_JAVA_OPTS=-Xms{{ opensearch_ad_heap }} -Xmx{{ opensearch_ad_heap }}
    ulimits:
      memlock:
        soft: -1
        hard: -1
      nofile:
        soft: 65536
        hard: 65536
    ports:
      - "{{ opensearch_ad_bind_host }}:{{ opensearch_ad_api_host_port }}:9200"
      - "{{ opensearch_ad_bind_host }}:{{ opensearch_ad_performance_host_port }}:9600"
    volumes:
      - opensearch-ad-data:/usr/share/opensearch/data
    networks:
      - opensearch-ad

  dashboards:
    image: "opensearchproject/opensearch-dashboards:{{ opensearch_ad_version }}"
    container_name: ad-opensearch-dashboards
    restart: unless-stopped
    depends_on:
      - opensearch
    env_file:
      - .env
    environment:
      - 'OPENSEARCH_HOSTS=["https://opensearch:9200"]'
      - OPENSEARCH_USERNAME=admin
      - OPENSEARCH_PASSWORD=${OPENSEARCH_INITIAL_ADMIN_PASSWORD}
      - OPENSEARCH_SSL_VERIFICATIONMODE=none
    ports:
      - "{{ opensearch_ad_bind_host }}:{{ opensearch_ad_dashboards_host_port }}:5601"
    networks:
      - opensearch-ad

volumes:
  opensearch-ad-data:

networks:
  opensearch-ad:
