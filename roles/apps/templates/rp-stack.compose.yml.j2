---
services:
{% if rp_stack_local_llm_enabled | default(false) | bool %}
  rp-local-llm:
    image: "{{ rp_stack_local_llm_image }}"
    container_name: rp-stack-local-llm
    restart: unless-stopped
    command:
      - -m
      - "/models/{{ rp_stack_local_llm_model_filename }}"
      - --alias
      - "{{ rp_stack_local_llm_model_alias }}"
      - --host
      - 0.0.0.0
      - --port
      - "8080"
      - -c
      - "{{ rp_stack_local_llm_context_tokens }}"
      - -ngl
      - "{{ rp_stack_local_llm_gpu_layers }}"
      - --flash-attn
      - on
      - --reasoning
      - off
      - -n
      - "1200"
      - -ctk
      - q8_0
      - -ctv
      - q8_0
      - -np
      - "1"
    volumes:
      - "{{ rp_stack_local_llm_model_dir }}:/models:ro"
    devices:
      - "/dev/dri/renderD128:/dev/dri/renderD128"
    expose:
      - "8080"
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3).read()"]
      interval: 30s
      timeout: 10s
      start_period: 10m
      retries: 6
    networks:
      - rp-llm

{% endif %}
  rp-gateway:
    build:
      context: ./rp-gateway
    container_name: rp-stack-gateway
    restart: unless-stopped
    env_file:
      - .env
    volumes:
      - "{{ rp_stack_gateway_data_dir }}:/data:rw"
      - "{{ rp_stack_state_dir }}:/state:rw"
      - "./worldpacks:/worldpacks:ro"
    expose:
      - "{{ rp_stack_gateway_port }}"
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:{{ rp_stack_gateway_port }}/health', timeout=3).read()"]
      interval: 30s
      timeout: 10s
      start_period: 30s
      retries: 3
    networks:
      - rp-stack
{% if rp_stack_local_llm_enabled | default(false) | bool %}
      - rp-llm
{% endif %}

  rp-light-gui:
    build:
      context: ./rp-light-gui
    container_name: rp-stack-light-gui
    restart: unless-stopped
    depends_on:
      rp-gateway:
        condition: service_healthy
    ports:
{% for bind_host in rp_stack_bind_hosts | default([rp_stack_bind_host]) %}
      - "{{ bind_host }}:{{ rp_stack_light_gui_host_port }}:80"
{% endfor %}
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1/health"]
      interval: 30s
      timeout: 10s
      start_period: 15s
      retries: 3
    networks:
      - rp-stack

networks:
  rp-stack:
    name: rp-stack
{% if rp_stack_local_llm_enabled | default(false) | bool %}
  rp-llm:
    name: rp-llm
    internal: true
{% endif %}
