<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="description" content="Приложения сервера abykovserv.">
  <title>Приложения · {{ application_portal_title | e }}</title>
  <link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="assets/portal.css">
  <script src="assets/portal.js" defer></script>
</head>
<body>
  <a class="skip-link" href="#applications">Перейти к приложениям</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="./" aria-label="{{ application_portal_title | e }} — все приложения"><img src="assets/favicon.svg" alt="" width="28" height="28">{{ application_portal_title | e }}</a>
      <span class="server-address">{{ application_portal_host | e }}</span>
    </div>
  </header>
  <main id="applications" tabindex="-1" aria-labelledby="page-title">
    <div class="catalog-toolbar">
      <h1 id="page-title">Приложения <span class="total-count">{{ application_portal_apps | length }}</span></h1>
      <div class="search">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 5 5"></path></svg>
        <label class="sr-only" for="search">Найти приложение</label>
        <input id="search" type="search" placeholder="Найти приложение" autocomplete="off">
        <kbd aria-hidden="true">/</kbd>
      </div>
    </div>
    <nav class="categories" aria-label="Категории приложений">
{% for key, label in [('all', 'Все'), ('work', 'Работа'), ('ai', 'AI и сценарии'), ('security', 'Безопасность'), ('system', 'Система')] %}
      <button class="nav-item{% if key == 'all' %} active{% endif %}" data-category="{{ key }}" data-label="{{ label }}" aria-pressed="{{ 'true' if key == 'all' else 'false' }}">{{ label }}<span class="nav-count">{{ application_portal_apps | length if key == 'all' else application_portal_apps | selectattr('category', 'equalto', key) | list | length }}</span></button>
{% endfor %}
    </nav>
    <p id="search-status" class="sr-only" role="status" aria-live="polite"></p>
    <div class="app-grid">
{% for app in application_portal_apps %}
      <a class="app-card" href="{{ app.url | e }}" data-category="{{ app.category | e }}" data-search="{{ (app.name ~ ' ' ~ app.subtitle ~ ' ' ~ app.description ~ ' ' ~ app.category_label ~ ' ' ~ app.address) | e }}" aria-label="Открыть {{ app.name | e }}{% if app.notice is defined %}. {{ app.notice | e }}{% endif %}"{% if app.note is defined %} aria-describedby="note-{{ app.id | e }}"{% endif %}>
        <div class="card-heading">
          <img class="app-icon" src="assets/{{ app.id | e }}.svg" alt="" width="32" height="32">
          <h2>{{ app.name | e }}</h2>
          <svg class="launch-arrow" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"></path></svg>
        </div>
        <p class="description">{{ app.description | e }}</p>
{% if app.notice is defined %}
        <div class="status-note"><span class="notice" title="{{ app.note | default('') | e }}">{{ app.notice | e }}</span><span class="sr-only" id="note-{{ app.id | e }}">{{ app.note | default('') | e }}</span></div>
{% endif %}
        <div class="card-footer"><span>{{ app.category_label | e }}</span><span class="address">{{ app.address | e }}</span></div>
      </a>
{% endfor %}
    </div>
    <div id="empty-state" class="empty-state" hidden><h2>Ничего не найдено</h2><p>Измените запрос или выберите другую категорию.</p><button id="reset-search">Сбросить поиск</button></div>
    <noscript><p class="noscript-note">Все ссылки работают без JavaScript. Для поиска и фильтров включите JavaScript.</p></noscript>
    <footer class="page-footer"><span>Показано: <span id="result-count">{{ application_portal_apps | length }}</span> из {{ application_portal_apps | length }}</span><span>Статусы — ручные отметки, без мониторинга.</span></footer>
  </main>
</body>
</html>
