{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/rp_stack_policy.ps1",
            "command_windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/rp_stack_policy.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
